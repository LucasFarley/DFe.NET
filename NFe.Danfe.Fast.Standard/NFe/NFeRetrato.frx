		private void Emitente_BeforePrint(object sender, EventArgs e)
		{
		var chave = Substring(((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.Id&quot;)), 3);
		TextChaveAcesso.Text = Regex.Replace(chave, &quot;.{4}&quot;, &quot;$0 &quot;);
		BarcodeChave.Text = chave;
		poEmitLogo.Image = ObterLogo();

		var crtEmit = (CRT)Report.GetColumnValue("NFe.NFe.infNFe.emit.CRT");
		if (crtEmit == CRT.SimplesNacional) txtCrt.Text = "1 - Simples Nacional";
		else if (crtEmit == CRT.SimplesNacionalExcessoSublimite) txtCrt.Text = "2 - Simples Nacional - excesso de sublimite de receita bruta";
		else if (crtEmit == CRT.RegimeNormal) txtCrt.Text = "3 - Regime Normal";
		else if (crtEmit == CRT.MicroempreendedorIndividual) txtCrt.Text = "4 - Microempreendedor Individual (MEI)";
		else txtCrt.Text = "";


		var contigenciaId = (string)Report.GetParameterValue(&quot;ContingenciaID&quot;);
		BarCodeContigencia.Visible = !string.IsNullOrEmpty(contigenciaId);
		if(BarCodeContigencia.Visible) BarCodeContigencia.Text = contigenciaId;
		DadosISSQN.Visible = !(bool)Report.GetParameterValue(&quot;ImprimirISSQN&quot;);
		prodRow.AutoSize = true;
		prodNomeCell.WordWrap = true;

		//Trato o campo de Frete
		switch((int)((ModalidadeFrete)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.modFrete&quot;)))
		{
		case 0: Memo92.Text = &quot;0 - Emit/Remet&quot;; break;
		case 1: Memo92.Text = &quot;1 - Destinatário&quot;; break;
		case 2: Memo92.Text = &quot;2 - Terceiros&quot;; break;
		case 3: Memo92.Text = &quot;3 - Prop Remetente&quot;; break;
		case 4: Memo92.Text = &quot;4 - Prop Destinatário&quot;; break;
		case 9: Memo92.Text = &quot;9 - Sem Frete&quot;; break;
		}

		var vol = Report.GetDataSource(&quot;NFe.NFe.infNFe.transp.vol&quot;);
		vol.Init();
		int qtdeVol = 0;

		int volumes = 0;
		decimal pesoL = 0;
		decimal pesoB = 0;
		while (vol.HasMoreRows)
		{
		Memo106.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.esp&quot;));
		Memo108.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.marca&quot;));
		Memo110.Text = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.nVol&quot;));

		volumes += ((Nullable&lt;int&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.qVol&quot;)) ?? 0;
		pesoL += ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.pesoL&quot;)) ?? 0M;
		pesoB += ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.transp.vol.pesoB&quot;)) ?? 0M;
		qtdeVol++;
		vol.Next();
		}

		if (qtdeVol &gt;= 1)
		{
		if (qtdeVol &gt; 1)
		{
		Memo106.Text = &quot;VOLUMES&quot;;
		Memo108.Text = &quot;&quot;;
		Memo110.Text = &quot;&quot;;
		}

		Memo104.Text = volumes.ToString();
		Memo112.Text = FormatNumber(pesoB,3) + &quot; KG&quot;;
		Memo114.Text = FormatNumber(pesoL,3) + &quot; KG&quot;;
		}

		if(Engine.FinalPass)
		{
		var vBC = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vBC&quot;)) ?? 0;
		var vISS = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vISS&quot;)) ?? 0;
		var vServ = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.total.ISSQNtot.vServ&quot;)) ?? 0;

		DadosISSQN.Visible = !(vBC == 0 &amp;&amp; vISS == 0 &amp;&amp; vServ == 0);

		var retiradaCPF = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.CPF&quot;);
		var retiradaCNPJ = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.CNPJ&quot;);
		var retiradaEndereco = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xLgr&quot;);
		var retiradaNro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.nro&quot;);
		var retiradaBairro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xBairro&quot;);
		var retiradaMunicipio = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.xMun&quot;);
		var retiradaUf = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.retirada.UF&quot;);

		LocalRetirada.Visible = !string.IsNullOrEmpty(retiradaCPF) || !string.IsNullOrEmpty(retiradaCNPJ) ||
		!string.IsNullOrEmpty(retiradaEndereco) || !string.IsNullOrEmpty(retiradaNro) ||
		!string.IsNullOrEmpty(retiradaBairro) || !string.IsNullOrEmpty(retiradaMunicipio) ||
		!string.IsNullOrEmpty(retiradaUf);

		var entregaCPF = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.CPF&quot;);
		var entregaCNPJ = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.CNPJ&quot;);
		var entregaEndereco = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xLgr&quot;);
		var entregaNro = (string)Report.GetColumnValue(&quot;[NFe.NFe.infNFe.entrega.nro]&quot;);
		var entregaBairro = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xBairro&quot;);
		var entregaMunicipio = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.xMun&quot;);
		var entregaUf = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.entrega.UF&quot;);

		LocalEntrega.Visible = !string.IsNullOrEmpty(entregaCPF) || !string.IsNullOrEmpty(entregaCNPJ) ||
		!string.IsNullOrEmpty(entregaEndereco) || !string.IsNullOrEmpty(entregaNro) ||
		!string.IsNullOrEmpty(entregaBairro) || !string.IsNullOrEmpty(entregaMunicipio) ||
		!string.IsNullOrEmpty(entregaUf);


		var indPagto =   (IndicadorPagamento?)Report.GetColumnValue(&quot;NFe.NFe.infNFe.ide.indPag&quot;);
		var fatnFat = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.cobr.fat.nFat&quot;);
		var fatvOrig = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.cobr.fat.vOrig&quot;)) ?? 0M;
		var fatvDesc = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.cobr.fat.vDesc&quot;)) ?? 0M;
		var fatvLiq = ((Nullable&lt;decimal&gt;)Report.GetColumnValue(&quot;NFe.NFe.infNFe.cobr.fat.vLiq&quot;)) ?? 0M;

		Fatura.Visible = (bool)Report.GetParameterValue(&quot;ExibeCampoFatura&quot;);
		MemoFatura.Visible  = !string.IsNullOrEmpty(fatnFat);
		if(MemoFatura.Visible) MemoFatura.Text = string.Format(&quot;Número: {0} - Valor Original: {1:c} - Valor Desconto: {2:c} - ValorLíquido: {3:c}&quot;,
		fatnFat, fatvOrig, fatvDesc, fatvLiq);

		switch(indPagto)
		{
		case IndicadorPagamento.ipVista:
		Memo146.Text = &quot;PAGAMENTO À VISTA&quot;;
		break;

		case IndicadorPagamento.ipPrazo:
		Memo146.Text = &quot;PAGAMENTO A PRAZO&quot;;
		break;

		case IndicadorPagamento.ipOutras:
		Memo146.Text = &quot;OUTROS&quot;;
		break;
		}
		}

		string infAdicionais = (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.infCpl&quot;) + Environment.NewLine + (string)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.infAdFisco&quot;);

		infAdicionais = infAdicionais.Replace(&quot;[&quot;,&quot;[\&quot;[&quot;).Replace(&quot;]&quot;,&quot;]\&quot;]&quot;);

		if((bool)Report.GetParameterValue(&quot;QuebrarLinhasObservacao&quot;))
		{
		infAdicionais = infAdicionais.Replace(&quot;;&quot;, Environment.NewLine);
		}
		var obsContList = Report.GetDataSource(&quot;NFe.NFe.infNFe.infAdic.obsCont&quot;);
		string varFinalObsCont = string.Empty;
		obsContList.Init();
		while (obsContList.HasMoreRows)
		{
		string varCampo = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.obsCont.xCampo&quot;));
		string varTexto = ((String)Report.GetColumnValue(&quot;NFe.NFe.infNFe.infAdic.obsCont.xTexto&quot;));
		varFinalObsCont += (varCampo + &quot;: &quot; + varTexto + &quot;; &quot;);
		obsContList.Next();
		}
		TextInfAdicionais.Text = infAdicionais + Environment.NewLine + varFinalObsCont;
		//infAdicionais = infAdicionais.Replace(&quot;[&quot;,&quot;[\&quot;[&quot;).Replace(&quot;]&quot;,&quot;]\&quot;]&quot;);

		//if((bool)Report.GetParameterValue(&quot;QuebrarLinhasObservacao&quot;))
		//{
		// infAdicionais = infAdicionais.Replace(&quot;;&quot;, Environment.NewLine);
		//}

		TextInfAdicionais.Text = infAdicionais;


		//memContInfAdicionais.Text = string.Empty;

		//string[] lines = infAdicionais.Split(new string[]{ Environment.NewLine, &quot;\n&quot; }, StringSplitOptions.None);
		//pgContDadosAdicionais.Visible = lines.Length &gt; LINHAS_DADOS_ADICIONAIS;

		//if(pgContDadosAdicionais.Visible)
		//{
		//  TextInfAdicionais.Text = string.Join(Environment.NewLine, lines.Take(LINHAS_DADOS_ADICIONAIS-1).ToArray());
		//  memContInfAdicionais.Text = string.Join(Environment.NewLine, lines.Skip(LINHAS_DADOS_ADICIONAIS-1).ToArray());
		//}
		}

		private void DadosProdutos_BeforePrint(object sender, EventArgs e)
		{
		var icmsBasico = (ICMSBasico)Report.GetColumnValue("NFe.NFe.infNFe.det.imposto.ICMS.TipoICMS");
		var ipiBasico = (IPIBasico)Report.GetColumnValue("NFe.NFe.infNFe.det.imposto.IPI.TipoIPI");
		var crtItem = (CRT)Report.GetColumnValue("NFe.NFe.infNFe.emit.CRT");

		string cst = "";
		decimal bcIcms = 0m;
		decimal vIcms = 0m;
		decimal pIcms = 0m;
		if (icmsBasico != null)
		{
		var orig = icmsBasico.GetIcmsOrig();
		if (crtItem == CRT.SimplesNacional || crtItem == CRT.MicroempreendedorIndividual)
		cst = orig.OrigemMercadoriaParaString() + icmsBasico.GetIcmsCsosn().CsosnicmsParaString();
		else
		cst = orig.OrigemMercadoriaParaString() + icmsBasico.GetIcmsCst().CsticmsParaString();
		bcIcms = icmsBasico.GetIcmsBcValue();
		vIcms = icmsBasico.GetIcmsValue();
		pIcms = icmsBasico.GetIcmsPercent();
		}

		decimal bcIpi = LerOpcional("NFe.NFe.infNFe.det.imposto.IPI.TipoIPI.vBC") ?? 0m;
		decimal vIpi = 0m;
		decimal pIpi = 0m;
		if (ipiBasico != null)
		{
		vIpi = ipiBasico.GetIpiValue();
		pIpi = ipiBasico.GetIpiPercent();
		}

		string cfop = Convert.ToString(Report.GetColumnValue("NFe.NFe.infNFe.det.prod.CFOP"));
		prodCstCfopCell.Text = "CST " + cst + Environment.NewLine + "CFOP " + cfop;

		var cProd = (string)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.cProd");
		var xProd = (string)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.xProd");
		var ncm = (string)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.NCM");
		var infAd = Report.GetColumnValue("NFe.NFe.infNFe.det.infAdProd") as string;
		var cClass = Report.GetColumnValue("NFe.NFe.infNFe.det.imposto.IBSCBS.cClassTrib") as string;
		string desc = (cProd ?? "") + " - " + (xProd ?? "");
		if (!string.IsNullOrEmpty(infAd)) desc = desc + Environment.NewLine + infAd;
		desc = desc + Environment.NewLine + "NCM " + (ncm ?? "");
		if (!string.IsNullOrEmpty(cClass)) desc = desc + "   cClassTrib " + cClass;
		prodNomeCell.Text = desc;

		var imprimirUnidQtdeValor = (ImprimirUnidQtdeValor)Report.GetParameterValue("ImprimirUnidQtdeValor");
		var imprimirDescPorc = (bool)Report.GetParameterValue("ImprimirDescPorc");
		var imprimirTotalLiquido = (bool)Report.GetParameterValue("ImprimirTotalLiquido");
		var uCom = (string)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.uCom");
		var uTrib = (string)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.uTrib");
		var qCom = (decimal)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.qCom");
		var qTrib = (decimal)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.qTrib");
		var vUnCom = (decimal)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.vUnCom");
		var vUnTrib = (decimal)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.vUnTrib");
		var vProd = (decimal)Report.GetColumnValue("NFe.NFe.infNFe.det.prod.vProd");
		var vDesc = LerOpcional("NFe.NFe.infNFe.det.prod.vDesc") ?? 0m;
		var decimaisQuantidadeItem = (int)Report.GetParameterValue("DecimaisQuantidadeItem");
		var decimaisValorUnitario = (int)Report.GetParameterValue("DecimaisValorUnitario");

		string qtdTexto = "";
		string unTexto = "";
		string unitTexto = "";
		if (imprimirUnidQtdeValor == ImprimirUnidQtdeValor.Tributavel)
		{
		qtdTexto = FormatNumber(qTrib, decimaisQuantidadeItem);
		unTexto = uTrib;
		unitTexto = FormatNumber(vUnTrib, decimaisValorUnitario);
		}
		else if (imprimirUnidQtdeValor == ImprimirUnidQtdeValor.Ambos)
		{
		qtdTexto = FormatNumber(qCom, decimaisQuantidadeItem) + Environment.NewLine + FormatNumber(qTrib, decimaisQuantidadeItem);
		unTexto = (uCom ?? "") + Environment.NewLine + (uTrib ?? "");
		unitTexto = FormatNumber(vUnCom, decimaisValorUnitario) + Environment.NewLine + FormatNumber(vUnTrib, decimaisValorUnitario);
		}
		else
		{
		qtdTexto = FormatNumber(qCom, decimaisQuantidadeItem);
		unTexto = uCom;
		unitTexto = FormatNumber(vUnCom, decimaisValorUnitario);
		}
		prodQtdUnCell.Text = qtdTexto + Environment.NewLine + unTexto;
		prodValorUnitarioCell.Text = unitTexto;

		decimal totalItem = vProd;
		if (imprimirTotalLiquido) totalItem = vProd - vDesc;
		string totalTexto = FormatNumber(totalItem, 2);
		if (vDesc.CompareTo(0m) &gt; 0)
		{
		if (imprimirDescPorc &amp;&amp; vUnCom * qCom != 0m)
		totalTexto = totalTexto + Environment.NewLine + "Desc " + FormatNumber((vDesc * 100m) / (vUnCom * qCom), 2) + "%";
		else
		totalTexto = totalTexto + Environment.NewLine + "Desc " + FormatNumber(vDesc, 2);
		}
		prodValorCell.Text = totalTexto;

		bool temIbs = TemGrupo("NFe.NFe.infNFe.det.imposto.IBSCBS.gIBSCBS");
		bool temIs = TemGrupo("NFe.NFe.infNFe.det.imposto.IS");
		string grupo = "NFe.NFe.infNFe.det.imposto.IBSCBS.gIBSCBS";

		string bases = "ICMS  " + FormatNumber(bcIcms, 2);
		if (temIbs) bases = bases + Environment.NewLine + "IBS/CBS  " + FormatNumber(LerOpcional(grupo + ".vBC") ?? 0m, 2);
		if (temIs) bases = bases + Environment.NewLine + "IS  " + FormatNumber(LerOpcional("NFe.NFe.infNFe.det.imposto.IS.vBCIS") ?? 0m, 2);
		bases = bases + Environment.NewLine + "IPI  " + FormatNumber(bcIpi, 2);
		prodBasesCell.Text = bases;

		string aliq = "ICMS  " + FormatNumber(pIcms, 2) + "%";
		if (temIbs) aliq = aliq + Environment.NewLine + "CBS  " + AliquotaGrupo(grupo + ".gCBS", "pCBS");
		aliq = aliq + Environment.NewLine + "IPI  " + FormatNumber(pIpi, 2) + "%";
		if (temIbs)
		{
		aliq = aliq + Environment.NewLine + "IBS UF  " + AliquotaGrupo(grupo + ".gIBSUF", "pIBSUF");
		aliq = aliq + Environment.NewLine + "IBS MUN  " + AliquotaGrupo(grupo + ".gIBSMun", "pIBSMun");
		}
		if (temIs) aliq = aliq + Environment.NewLine + "IS  " + FormatNumber(LerOpcional("NFe.NFe.infNFe.det.imposto.IS.pIS") ?? 0m, 2) + "%";
		prodAliqCell.Text = aliq;

		string tribs = "ICMS  " + FormatNumber(vIcms, 2);
		if (temIbs) tribs = tribs + Environment.NewLine + "CBS  " + FormatNumber(LerOpcional(grupo + ".gCBS.vCBS") ?? 0m, 2);
		tribs = tribs + Environment.NewLine + "IPI  " + FormatNumber(vIpi, 2);
		if (temIbs)
		{
		tribs = tribs + Environment.NewLine + "IBS UF  " + FormatNumber(LerOpcional(grupo + ".gIBSUF.vIBSUF") ?? 0m, 2);
		tribs = tribs + Environment.NewLine + "IBS MUN  " + FormatNumber(LerOpcional(grupo + ".gIBSMun.vIBSMun") ?? 0m, 2);
		}
		if (temIs) tribs = tribs + Environment.NewLine + "IS  " + FormatNumber(LerOpcional("NFe.NFe.infNFe.det.imposto.IS.vIS") ?? 0m, 2);
		prodTribCell.Text = tribs;
		}

		private string AliquotaGrupo(string grupoAliquota, string aliquota)
		{
		if (TemGrupo(grupoAliquota + ".gRed"))
		return FormatNumber(LerTotal(grupoAliquota + ".gRed.pAliqEfet"), 2) + "%";
		return FormatNumber(LerTotal(grupoAliquota + "." + aliquota), 2) + "%";
		}

		private string FormatarCampo(string valor, char format)
		{
		switch (format)
		{
		case 'c':  //CEP
		if (valor.Length == 8)
		valor = valor.Substring(0,2) + &quot;.&quot; + valor.Substring(2,3) + &quot;-&quot; + valor.Substring(5,3);
		break;

		case 'f':  //Telefone /celular
		if (valor.Length == 10)
		valor = &quot;(&quot; +valor.Substring(0,2) + &quot;)&quot; + valor.Substring(2,4) + &quot;-&quot; + valor.Substring(6,4);
		else if (valor.Length == 11)
		valor = &quot;(&quot; +valor.Substring(0,2) + &quot;)&quot; + valor.Substring(2,5) + &quot;-&quot; + valor.Substring(7,4);
		break;

		case 'd': //cpf / cnpj
		if (valor.Length == 11)
		valor = valor.Substring(0,3)+&quot;.&quot;+valor.Substring(3,3)+&quot;.&quot;+valor.Substring(6,3)+&quot;-&quot;+valor.Substring(9,2);
		else if (valor.Length == 14)
		valor = valor.Substring(0,2)+&quot;.&quot;+valor.Substring(2,3)+&quot;.&quot;+valor.Substring(5,3)+&quot;/&quot;+valor.Substring(8,4)+&quot;-&quot;+valor.Substring(12,2);
		break;

		case 'p':
		if (valor.Length == 7)
		valor = valor.Substring(0,3)+&quot;-&quot;+valor.Substring(3,4);
		break;
		}
		return valor;
		}

		public Image ObterLogo()
		{
		byte[] logomarca = Report.GetParameterValue(&quot;Logo&quot;) as byte[];
		if(logomarca == null)
		return null;
		Stream imageStream = new MemoryStream(logomarca); //precisa ficar aberto senao causa erro gdi+ #Zeus Issue 1119, acesse a issue para mais detalhes.
		var image = Image.FromStream(imageStream);
		return image;
		}

		private void Imposto_BeforePrint(object sender, EventArgs e)
		{
		}

		private void AplicarQrCode()
		{
		string qr = null;
		try { qr = Report.GetColumnValue("NFe.NFe.infNFeSupl.qrCode") as string; }
		catch { qr = null; }
		bool tem = !string.IsNullOrEmpty(qr);
		QuadroQr.Visible = tem;
		bcoQrDanfe.Visible = tem;
		if (tem)
		{
		bcoQrDanfe.Text = qr;
		DadosAdicionais.Height = 128f;
		Text155.Width = 400f;
		Text155.Height = 110f;
		TextInfAdicionais.Width = 396f;
		TextInfAdicionais.Height = 92f;
		Text156.Left = 400f;
		Text156.Width = 224.66f;
		Text156.Height = 110f;
		Text37.Left = 402f;
		Text37.Width = 220f;
		Text37.Height = 92f;
		}
		else
		{
		DadosAdicionais.Height = 60.15f;
		Text155.Width = 470.06f;
		Text155.Height = 45.36f;
		TextInfAdicionais.Width = 468.5f;
		Text156.Left = 470.5f;
		Text156.Width = 274.06f;
		Text156.Height = 45.36f;
		Text37.Left = 472.5f;
		Text37.Width = 270.05f;
		}
		}

		private void DadosAdicionais_BeforePrint(object sender, EventArgs e)
		{
		AplicarQrCode();
		}


		decimal LerTotal(string coluna)
		{
		try
		{
		object valor = Report.GetColumnValue(coluna);
		if (valor == null) return 0m;
		return Convert.ToDecimal(valor);
		}
		catch
		{
		return 0m;
		}
		}

		string FormatarTotal(decimal valor)
		{
		return valor.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
		}

		decimal? LerOpcional(string coluna)
		{
		try
		{
		object valor = Report.GetColumnValue(coluna);
		if (valor == null) return null;
		return Convert.ToDecimal(valor);
		}
		catch
		{
		return null;
		}
		}

		bool TemGrupo(string coluna)
		{
		try
		{
		return Report.GetColumnValue(coluna) != null;
		}
		catch
		{
		return false;
		}
		}


		private void TotalIbsCbs_BeforePrint(object sender, EventArgs e)
		{
		txtCbs.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gCBS.vCBS"));
		txtIbsUf.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gIBS.gIBSUF.vIBSUF"));
		txtIbsMun.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gIBS.gIBSMun.vIBSMun"));
		txtIs.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.ISTot.vIS"));

		bool temMono = TemGrupo("NFe.NFe.infNFe.total.IBSCBSTot.gMono");
		decimal ibsMonoReten = temMono ? LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gMono.vIBSMonoReten") : 0m;
		decimal cbsMonoReten = temMono ? LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gMono.vCBSMonoReten") : 0m;
		bool temReten = temMono &amp;&amp; (ibsMonoReten.CompareTo(0m) != 0 || cbsMonoReten.CompareTo(0m) != 0);

		QuadroIbsMono.Visible = temMono;
		txtIbsMono.Visible = temMono;
		QuadroCbsMono.Visible = temMono;
		txtCbsMono.Visible = temMono;
		QuadroIbsMonoReten.Visible = temReten;
		txtIbsMonoReten.Visible = temReten;
		QuadroCbsMonoReten.Visible = temReten;
		txtCbsMonoReten.Visible = temReten;

		if (temMono)
		{
		txtIbsMono.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gMono.vIBSMono"));
		txtCbsMono.Text = FormatarTotal(LerTotal("NFe.NFe.infNFe.total.IBSCBSTot.gMono.vCBSMono"));
		txtIbsMonoReten.Text = FormatarTotal(ibsMonoReten);
		txtCbsMonoReten.Text = FormatarTotal(cbsMonoReten);
		TotalIbsCbs.Height = 70.45f;
		}
		else
		{
		TotalIbsCbs.Height = 44f;
		}
		}



		private void ImpostosComplementares_BeforePrint(object sender, EventArgs e)
		{
		string[] rotulos = new string[] {
		"VALOR DO FCP",
		"VALOR DO FCP RETIDO POR ST",
		"VALOR DO DIFAL NA UF DE DESTINO",
		"VALOR DO FCP NA UF DE DESTINO",
		"BC DO ICMS MONOFÁSICO",
		"VALOR DO ICMS MONOFÁSICO",
		"BC DO ICMS MONOFÁSICO POR RETENÇÃO",
		"VALOR DO ICMS MONOFÁSICO POR RETENÇÃO"
		};
		string[] colunas = new string[] {
		"NFe.NFe.infNFe.total.ICMSTot.vFCP",
		"NFe.NFe.infNFe.total.ICMSTot.vFCPST",
		"NFe.NFe.infNFe.total.ICMSTot.vICMSUFDest",
		"NFe.NFe.infNFe.total.ICMSTot.vFCPUFDest",
		"NFe.NFe.infNFe.total.ICMSTot.qBCMono",
		"NFe.NFe.infNFe.total.ICMSTot.vICMSMono",
		"NFe.NFe.infNFe.total.ICMSTot.qBCMonoReten",
		"NFe.NFe.infNFe.total.ICMSTot.vICMSMonoReten"
		};
		TextObject[] quadros = new TextObject[] { QComp0, QComp1, QComp2, QComp3, QComp4, QComp5, QComp6, QComp7 };
		TextObject[] valores = new TextObject[] { VComp0, VComp1, VComp2, VComp3, VComp4, VComp5, VComp6, VComp7 };
		int n = 0;
		int i = 0;
		while (i &lt; rotulos.Length)
		{
		decimal? valor = LerOpcional(colunas[i]);
		bool mostra = valor.HasValue;
		quadros[i].Visible = mostra;
		valores[i].Visible = mostra;
		if (mostra)
		{
		int coluna = n % 4;
		int linha = n / 4;
		float esquerda = coluna * 186.16f;
		float topo = linha * 26.46f;
		quadros[i].Left = esquerda;
		quadros[i].Top = topo;
		quadros[i].Width = 186.16f;
		quadros[i].Text = rotulos[i];
		valores[i].Left = esquerda + 0.4f;
		valores[i].Top = topo + 8.2f;
		valores[i].Width = 185f;
		if (i == 4 || i == 6) valores[i].Text = valor.Value.ToString("N4", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
		else valores[i].Text = FormatarTotal(valor.Value);
		n = n + 1;
		}
		i = i + 1;
		}
		if (n == 0)
		{
		ImpostosComplementares.Visible = false;
		ImpostosComplementares.Height = 0f;
		}
		else
		{
		int linhas = ((n - 1) / 4) + 1;
		ImpostosComplementares.Visible = true;
		ImpostosComplementares.Height = linhas * 26.46f;
		}
		}

		private int contadorDuplicatas =0;
		private float _TamanhoDuplicatas = 0;

		private void DuplicatasHeader_BeforePrint(object sender, EventArgs e)
		{
		contadorDuplicatas = 0;
		_TamanhoDuplicatas = 0;
		}

		private void Duplicatas_BeforePrint(object sender, EventArgs e)
		{
		contadorDuplicatas++;
		if (contadorDuplicatas == 6)
		{
		_TamanhoDuplicatas += Duplicatas.Height;
		contadorDuplicatas = 0;
		}
		}

		private float _Tamanho = 0;
		private float _TamanhoItens = 0;

		private void DadosProdutosHeader_BeforePrint(object sender, EventArgs e)
		{
		_Tamanho = 0;
		_TamanhoItens = 0;

		if (Canhoto.Visible)
		_Tamanho += Canhoto.Height;

		if (Emitente.Visible)
		_Tamanho += Emitente.Height;

		if (Destinatario.Visible)
		_Tamanho += Destinatario.Height;

		if (LocalRetirada.Visible)
		_Tamanho += LocalRetirada.Height;

		if (LocalEntrega.Visible)
		_Tamanho += LocalEntrega.Height;

		if (Fatura.Visible)
		_Tamanho += Fatura.Height;

		if (DuplicatasHeader.Visible)
		_Tamanho += DuplicatasHeader.Height;

		_Tamanho += _TamanhoDuplicatas;

		if (TotalProdutos.Visible)
		_Tamanho += TotalProdutos.Height;

		if (Imposto.Visible)
		_Tamanho += Imposto.Height;

		if (ImpostosComplementares.Visible)
		_Tamanho += ImpostosComplementares.Height;

		if (TotalIbsCbs.Visible)
		_Tamanho += TotalIbsCbs.Height;

		if (DadosISSQN.Visible)
		_Tamanho += DadosISSQN.Height;

		if (TransportadorVolumes.Visible)
		_Tamanho += TransportadorVolumes.Height;

		if (DadosProdutosHeader.Visible)
		_Tamanho += DadosProdutosHeader.Height;

		//_Tamanho += _TamanhoItens;

		if (DadosProdutosFooter.Visible)
		_Tamanho += DadosProdutosFooter.Height;

		AplicarQrCode();
		DadosAdicionais.CalcHeight();

		if (DadosAdicionais.Visible)
		_Tamanho += DadosAdicionais.Height;

		if (Rodape.Visible)
		_Tamanho += Rodape.Height;

		}

		private void DadosProdutos_AfterPrint(object sender, EventArgs e)
		{
		DadosProdutos.StartNewPage = false;

		if (Engine.PageNo == 1)
		{
		_TamanhoItens += DadosProdutos.Height;

		if (_Tamanho + _TamanhoItens &gt;= Engine.PageHeight)
		{
		DadosProdutos.StartNewPage = true;
		_TamanhoItens = 0;
		}
		}
		}



		}
		}
	</ScriptText>
